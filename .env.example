DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/naaib?schema=public"
# At least 32 random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=""
# Public URL of the site, used in email links
APP_URL="http://localhost:3000"
# Used once by `npm run db:seed` to create the owner account
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Optional SMTP. When unset, customer emails are recorded in the
# Communications log only (status LOGGED_ONLY) and not delivered.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Where uploaded photos and brochures are stored
UPLOAD_DIR="./storage/uploads"
